# Copy to .env (gitignored). Everything below is OPTIONAL for the offline demo; defaults give mock/offline mode.
# --- core (REPLACE for any non-local use) ---
JWT_SECRET=                 # python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=             # strong password for the admin user
DEMO_SEED=true              # creates analyst/buyer/field demo users; set false in production
DATABASE_URL=sqlite:///./data/groundproof.db   # compose uses PostgreSQL automatically
# --- baseline cutoff (Whisp) ---
CUTOFF_ADAPTER=mock         # mock | whisp
GEE_SERVICE_ACCOUNT_JSON=   # path to Google Earth Engine service-account key JSON (https://earthengine.google.com/). Commercial use needs a paid licence.
# --- imagery ---
IMAGERY_MODE=offline        # offline (synthetic) | stac (real Sentinel via STAC; needs rasterio extras)
STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1   # or https://stac.dataspace.copernicus.eu/v1
PC_SUBSCRIPTION_KEY=        # optional, Planetary Computer higher rate limit
CDSE_USERNAME=              # optional, https://dataspace.copernicus.eu
CDSE_PASSWORD=
FIRMS_MAP_KEY=              # free NASA FIRMS map key https://firms.modaps.eosdis.nasa.gov/api/map_key/
# --- commercial tasking (OFF by default) ---
ICEYE_ENABLED=false
ICEYE_API_KEY=              # partner agreement required; the mock is used regardless until a real adapter is wired
TASKING_MONTHLY_BUDGET_EUR=5000
TASKING_FOUR_EYES=true
# --- detector thresholds ---
MIN_CLEARING_HA=0.5
NDVI_DROP_THRESHOLD=0.25
SAR_DROP_DB=3.0
# --- content credentials ---
C2PA_CERT_PATH=             # production signing certificate (PEM chain) from a C2PA-trusted CA
C2PA_KEY_PATH=
# --- notifications (not used by the MVP yet) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# --- God's Eye View (full console, `make gev`); see console/gev/.env.example ---
GP_API_URL=http://localhost:8000
GP_API_EMAIL=analyst@example.com
GP_API_PASSWORD=demo-analyst
GOOGLE_MAPS_API_KEY=        # optional: photorealistic 3D tiles
CESIUM_ION_TOKEN=           # optional
OPENAI_API_KEY=             # optional: GEV voice features
